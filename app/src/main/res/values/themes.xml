<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BudzetDomowy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
    </style>

    <style name="Theme.BudzetDomowy.Splash" parent="Theme.SplashScreen">
        <!-- Brand green — cream looked like a blank white flash on OPPO -->
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BudzetDomowy</item>
    </style>
</resources>
